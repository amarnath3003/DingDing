# Copy to code/.env and fill in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Voice (macOS `say -v '?'` lists voices). Fred is the closest to Hawking's.
TTS_VOICE=Fred
SYSTEM_VOICE=Samantha

# Face: 0 = laptop camera. Later: http://<esp32-cam-ip>:81/stream
CAMERA_SOURCE=0
FACE_ENABLED=1

# Real bell (ESP32 running bell_test/bell_test.ino). Empty = Enter key only.
BELL_SERIAL_PORT=
