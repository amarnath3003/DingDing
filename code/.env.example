# Copy to code/.env and fill in. (code/.env is gitignored.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# User's voice: OpenAI TTS (cheapest model) with disk cache; local macOS voice as fallback.
TTS_ENGINE=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
TTS_PREFETCH=2
TTS_MAX_WAIT_S=2.5
TTS_VOICE=Alex          # local fallback; "Fred" sounds like Hawking
SYSTEM_VOICE=Samantha   # DING's own alerts (always local)

# Microphone (people talking to the user): off until switched on from the screen.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
MIC_DEFAULT_ON=0

# Face: 0 = laptop camera. Later: http://<esp32-cam-ip>:81/stream
CAMERA_SOURCE=0
FACE_ENABLED=1

# Real bell (ESP32 running bell_test/bell_test.ino). Empty = Enter key only.
BELL_SERIAL_PORT=
